{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@imurun/schema": ["./packages/schema/src/index.ts"],
      "@imurun/util": ["./packages/util/src/index.ts"],
      "@imurun/core": ["./packages/core/src/index.ts"],
      "@imurun/runtime": ["./packages/runtime/src/index.ts"],
      "@imurun/modelmgr": ["./packages/modelmgr/src/index.ts"],
      "@imurun/tui": ["./packages/tui/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
