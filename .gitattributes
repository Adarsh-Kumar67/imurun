# Normalise line endings in the repository so Windows, macOS and Linux check
# the same bytes out of git.
* text=auto eol=lf

# Windows launchers must keep CRLF to behave under cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets are never translated.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.gguf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
