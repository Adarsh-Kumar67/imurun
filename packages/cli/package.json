{
  "name": "@imurun/cli",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "IMURUN command-line interface",
  "license": "MIT",
  "bin": {
    "imurun": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@imurun/core": "workspace:*",
    "@imurun/modelmgr": "workspace:*",
    "@imurun/runtime": "workspace:*",
    "@imurun/schema": "workspace:*",
    "@imurun/tui": "workspace:*",
    "@imurun/util": "workspace:*",
    "chalk": "^5.6.0"
  }
}
