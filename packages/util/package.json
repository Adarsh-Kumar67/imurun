{
  "name": "@imurun/util",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "IMURUN shared utilities",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
