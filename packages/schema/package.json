{
  "name": "@imurun/schema",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "IMURUN shared schemas and types",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external zod && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
