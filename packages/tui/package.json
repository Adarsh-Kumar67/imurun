{
  "name": "@imurun/tui",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "IMURUN interactive terminal UI: chat, slash commands, agents",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@imurun/core": "workspace:*",
    "@imurun/modelmgr": "workspace:*",
    "@imurun/runtime": "workspace:*",
    "@imurun/schema": "workspace:*",
    "@imurun/util": "workspace:*",
    "chalk": "^5.6.0"
  }
}
