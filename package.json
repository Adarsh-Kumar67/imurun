{
  "name": "imurun-workspace",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "IMURUN - local-first AI coding agent workspace",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "package": "bun run scripts/package.ts",
    "package:binaries": "bun run scripts/package.ts -- --binaries",
    "release": "bun run scripts/release-github.ts",
    "check": "bun run scripts/check-release.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
